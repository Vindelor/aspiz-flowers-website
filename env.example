SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Custom admin path so bots scanning for the default /admin/ find nothing.
# Must end with a trailing slash. Leave unset locally to keep using /admin/.
ADMIN_URL=admin/

# Set to True only when deployed behind a reverse proxy (Nginx/Cloudflare)
# that terminates SSL — required for SECURE_SSL_REDIRECT to work correctly.
BEHIND_PROXY=False

# Required in production once the site is on a real HTTPS domain.
# Comma-separated, full origins including scheme, e.g.:
# CSRF_TRUSTED_ORIGINS=https://cicekdeposu.com,https://www.cicekdeposu.com
CSRF_TRUSTED_ORIGINS=

DB_NAME=shop_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- WhatsApp Business Cloud API (Meta) ---
# Get these from https://developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# The admin/staff WhatsApp number that receives new-order alerts, in international
# format with no +, spaces or leading zeros, e.g. 905XXXXXXXXX for Turkey.
WHATSAPP_ADMIN_PHONE=905XXXXXXXXX
# The exact name of the approved message template used to send the alert
# (must be approved in Meta Business Manager beforehand — see README).
WHATSAPP_ORDER_TEMPLATE_NAME=new_order_alert
WHATSAPP_TEMPLATE_LANGUAGE=tr

# Base URL of the site — used to build links inside emails/WhatsApp messages.
# Set to your real domain in production, e.g. https://cicekdeposu.com
SITE_BASE_URL=http://127.0.0.1:8000

# --- Email (SMTP) — required for "şifremi unuttum" password reset ---
# Leave all three blank to keep using the console backend (emails print to
# the server log instead of sending — fine for local dev, not for real
# users). Any standard SMTP provider works (Gmail, Zoho, SendGrid, your
# hosting provider's mail server, etc.) — get the host/port/credentials
# from that provider's SMTP settings page.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@aspizflowers.com

# --- Google OAuth ("Google ile giriş yap") ---
# From https://console.cloud.google.com -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application.
# Under "Authorized redirect URIs" add exactly:
#   <SITE_BASE_URL>/accounts/google/callback/
# The login button stays hidden/disabled until both values below are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
